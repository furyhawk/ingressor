# Marker PDF Converter - Environment Variables

# PyTorch/ML Configuration
PYTORCH_ENABLE_MPS_FALLBACK=1

# Server Configuration
REFLEX_PORT=3000
REFLEX_HOST=0.0.0.0

# Marker Configuration
MARKER_DEBUG=false
MARKER_LOG_LEVEL=INFO

# Optional: LLM Configuration (if using LLM mode)
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=gpt-4

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=100
UPLOAD_TEMP_DIR=/tmp/marker_uploads

# Processing Configuration
PDFTEXT_WORKERS=1
OCR_TIMEOUT_SECONDS=300
